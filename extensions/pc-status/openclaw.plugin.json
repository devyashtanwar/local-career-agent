{
  "id": "pc-status",
  "name": "Read-only PC status",
  "activation": {
    "onStartup": true
  },
  "commandAliases": [
    {
      "name": "pcstatus",
      "kind": "runtime-slash"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "allowedUsers": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "repo": {
        "type": "string",
        "minLength": 1
      },
      "python": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "allowedUsers",
      "repo",
      "python"
    ]
  }
}