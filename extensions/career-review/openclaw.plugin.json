{
  "id": "career-review",
  "name": "Career draft review",
  "description": "Owner-only deterministic draft reviews without model tools.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "owner": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "repo": {
        "type": "string",
        "minLength": 1
      },
      "python": {
        "type": "string",
        "minLength": 1
      },
      "settingsFile": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "owner",
      "repo",
      "python",
      "settingsFile"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "commandAliases": [
    {
      "name": "careerreview",
      "kind": "runtime-slash"
    }
  ]
}